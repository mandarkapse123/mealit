# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Firebase Service Account JSON (can be a raw JSON string or path to a .json file)
# In GitHub Actions, put the entire JSON content into the FIREBASE_SERVICE_ACCOUNT secret
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Timezone for calculating "today's date" (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Whether to send a message when a member has no meal plan set for today (true or false)
NOTIFY_IF_EMPTY=false

# Optional: Set DRY_RUN=true to test script without actually sending Telegram messages
DRY_RUN=false
